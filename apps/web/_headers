# Cloudflare Pages / Netlify header rules.
# Hashed-by-deploy assets are immutable; live data gets a short TTL so a schedule
# change reaches people quickly without hammering the origin.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/styles/*
  Cache-Control: public, max-age=604800

/src/*
  Cache-Control: public, max-age=604800

/data/geo/*
  Cache-Control: public, max-age=86400
  Content-Type: application/geo+json; charset=utf-8

/data/geo/gazetteer.json
  Cache-Control: public, max-age=86400
  Content-Type: application/json; charset=utf-8

/data/registry/*
  Cache-Control: public, max-age=3600

/data/schedules/index.json
  Cache-Control: public, max-age=300, stale-while-revalidate=1800

/data/schedules/*
  Cache-Control: public, max-age=900, stale-while-revalidate=3600

/sw.js
  Cache-Control: no-cache
