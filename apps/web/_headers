# Cloudflare Pages / Netlify header rules.
#
# The rule that matters: A LONG max-age IS ONLY SAFE ON A FILENAME THAT CHANGES
# WHEN ITS CONTENT DOES. Nothing here is content-hashed. This file used to open
# by calling these assets "hashed-by-deploy" and gave /src/* a seven day TTL,
# which was an intent the filenames never implemented: /src/map.js keeps that
# name forever, so every browser pinned the whole bundle for a week and no
# deploy could reach a returning visitor. Fixing the service worker did not
# help, because this is a second, independent cache sitting in front of it, and
# the two failures look identical from the outside.
#
# So code revalidates on every load. With an ETag that costs one 304 and a few
# hundred bytes, which is the right price for never shipping a fix nobody can
# receive. Data keeps a short TTL so a schedule change lands quickly without
# hammering the origin.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()

# Third-party bundles change only when we upgrade them, but the filename does
# not change when we do, so "immutable" would strand everyone on the old copy.
# A day bounds that without costing a revalidation on every page view.
/vendor/*
  Cache-Control: public, max-age=86400

/styles/*
  Cache-Control: no-cache

/src/*
  Cache-Control: no-cache

# The HTML names the scripts. Serving it stale hands back the old bundle even
# when everything it references is fresh.
/*.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/data/geo/*
  Cache-Control: public, max-age=86400
  Content-Type: application/geo+json; charset=utf-8

/data/geo/gazetteer.json
  Cache-Control: public, max-age=86400
  Content-Type: application/json; charset=utf-8

/data/registry/*
  Cache-Control: public, max-age=3600

/data/schedules/index.json
  Cache-Control: public, max-age=300, stale-while-revalidate=1800

/data/schedules/*
  Cache-Control: public, max-age=900, stale-while-revalidate=3600

/sw.js
  Cache-Control: no-cache
